# macOS
.DS_Store
**/.DS_Store

# Environment — NEVER commit this
.env
.env.local

# Obsidian personal layout (regenerated per user)
.obsidian/workspace.json
.obsidian/workspace
.obsidian/graph.json

# Python
__pycache__/
*.pyc

# OpenCode
.opencode/**/*.db
.opencode/**/*.db-shm
.opencode/**/*.db-wal
.opencode/autoresearch/__pycache__/

# Temporary
*.tmp
*.log
graphify-out/

# Vault content — research output is generated locally.
# Uncomment the lines below if you want to keep your research private.
# By default, research files ARE tracked so you can version-control your vault.
# vault/research/**/*.md
# vault/atomic-notes/**/*.md
