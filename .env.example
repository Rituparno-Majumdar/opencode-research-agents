# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: Gemini API key (or other supported model provider)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required: GitHub personal access token (for prompt improvement PRs)
# Needs repo scope. Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token

# Required: Your GitHub repo in the format username/repo-name
GITHUB_REPO=yourusername/your-repo-name

# Optional: Path to your Obsidian second brain vault for cross-vault sync
# If set, research files are copied here after each run (Phase 4)
# Example: OBSIDIAN_SECOND_BRAIN_PATH=/path/to/obsidian-vault/raw/research
OBSIDIAN_SECOND_BRAIN_PATH=
