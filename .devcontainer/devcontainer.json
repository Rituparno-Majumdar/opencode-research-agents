{
  "name": "OpenCode Autoresearch",
  "image": "mcr.microsoft.com/devcontainers/python:3.10",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black",
        "ms-python.isort",
        "ms-python.pylint"
      ]
    }
  },
  "postCreateCommand": "pip install pytest rich",
  "remoteUser": "vscode"
}